	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Автоматический вход под администратором, если токена нет или он истекает в ближайшую минуту",
					"const token = pm.collectionVariables.get('adminToken');",
					"const expiresAt = Number(pm.collectionVariables.get('adminTokenExpiresAt') || 0);",
					"if (!token || Date.now() > expiresAt - 60000) {",
					"    pm.sendRequest({",
					"        url: pm.collectionVariables.get('baseUrl') + '/api/auth/login',",
					"        method: 'POST',",
					"        header: { 'Content-Type': 'application/json' },",
					"        body: { mode: 'raw', raw: JSON.stringify({",
					"            userName: pm.collectionVariables.get('adminUserName'),",
					"            password: pm.collectionVariables.get('adminPassword') }) }",
					"    }, function (err, res) {",
					"        if (err || res.code !== 200) { console.error('Admin login failed', err || res.code); return; }",
					"        const r = res.json().result;",
					"        pm.collectionVariables.set('adminToken', r.accessToken);",
					"        pm.collectionVariables.set('adminTokenExpiresAt', String(Date.parse(r.expiresAt)));",
					"    });",
					"}"
				]
			}
		}
	]
