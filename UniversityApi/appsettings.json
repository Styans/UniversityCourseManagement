{
  "Database": {
    "Provider": "SqlServer",
    "SeedTestData": true
  },
  "ConnectionStrings": {
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=UniversityCourseDb;Trusted_Connection=True;TrustServerCertificate=True",
    "PostgreSql": "Host=localhost;Port=5432;Database=university_course_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "UniversityCourseManagementApi",
    "Audience": "UniversityCourseManagementClients",
    "AccessTokenMinutes": 15,
    "Key": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5210",
      "http://localhost:3000"
    ]
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Directory": "logs"
    }
  },
  "AllowedHosts": "*"
}
